        if OwnerAttribute ~= nil then
            if tonumber(OwnerAttribute) == LocalPlayer.UserId then
                DebugPrint(
                    "Own plot found by attribute:",
                    Plot:GetFullName()
                )
                return Plot
            end
        end
        local OwnerObject = Plot:FindFirstChild("OwnerUserId")
