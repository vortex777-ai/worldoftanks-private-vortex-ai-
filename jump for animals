local function GetSquatDetection(Plot)
    if not Plot then
        return nil
    end
    local SquatZone = Plot:FindFirstChild("SquatZone", true)
    local Floor = SquatZone and SquatZone:FindFirstChild("Floor", true) or nil
    local function FindDetection(Container)
        if not Container then
            return nil
        end
        local Detection = Container:FindFirstChild("Detector")
        if Detection then
            return Detection
        end
        Detection = Container:FindFirstChild("detector")
        if Detection then
            return Detection
        end
        for _, Object in ipairs(Container:GetDescendants()) do
            local Name = string.lower(Object.Name)
            if Name == "detection" or string.find(Name, "detection", 1, true) then
                return Object
            end
        end
        return nil
    end
    local Detection = FindDetection(Floor)
    if Detection then
        return Detection
    end
    Detection = FindDetection(SquatZone)
    if Detection then
        return Detection
    end
    Detection = FindDetection(Plot)
    if Detection then
        return Detection
    end
    DebugPrint("Strength Farm Detector instance not found:", Plot:GetFullName())
    return nil
end
local function GetDetectionPosition(Detection)
    if not Detection then
        return nil
    end
    local Success, DetectionCFrame = pcall(function()
        return Detection.CFrame
    end)
    if Success and typeof(DetectionCFrame) == "CFrame" then
        return DetectionCFrame.Position
    end
    if Detection:IsA("Attachment") then
        return Detection.WorldPosition
    end
    if Detection:IsA("BasePart") then
        return Detection.Position
    end
    if Detection:IsA("Model") then
        return Detection:GetPivot().Position
    end
    local Part = Detection:FindFirstChildWhichIsA("BasePart", true)
    if Part then
        return Part.Position
    end
    return nil
end
