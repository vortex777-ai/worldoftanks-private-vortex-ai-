local function IsInsidePlacementZone(
    Zone,
    Position
)
    if not Zone then
        return false
    end
    local LocalPosition =
        Zone.CFrame:PointToObjectSpace(
            Position
        )
    local HalfX =
        Zone.Size.X / 2
        - PLACEMENT_EDGE_MARGIN
    local HalfZ =
        Zone.Size.Z / 2
        - PLACEMENT_EDGE_MARGIN
    if HalfX <= 0
        or HalfZ <= 0 then
        return false
    end
    return math.abs(
        LocalPosition.X
    ) <= HalfX
        and math.abs(
            LocalPosition.Z
        ) <= HalfZ
end
