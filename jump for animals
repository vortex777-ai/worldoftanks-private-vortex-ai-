local function MoveToAttachment(
    Attachment,
    MaxDistance
)
    if not Attachment
        or not Attachment.Parent then
        return false
    end
    local TargetPosition
    local Success =
        pcall(function()
            TargetPosition =
                Attachment.WorldPosition
        end)
    if not Success
        or not TargetPosition then
        return false
    end
    if not MoveToPosition(
        TargetPosition,
        2.5
    ) then
        return false
    end
    if not RootPart then
        return false
    end
    local Distance =
        (
            RootPart.Position
            - TargetPosition
        ).Magnitude
    DebugPrint(
        "Moved to attachment. Distance:",
        tostring(Distance),
        "Allowed:",
        tostring(MaxDistance)
    )
    return Distance <= MaxDistance
end
local function ActivatePrompt(Prompt)
    if not Prompt
        or not Prompt.Parent then
        return false
    end
    if not Prompt:IsA("ProximityPrompt") then
        return false
    end
    if not Prompt.Enabled then
        return false
    end
    local HoldDuration =
        tonumber(
            Prompt.HoldDuration
        ) or 0.5
    DebugPrint(
        "Activating:",
        Prompt:GetFullName(),
        "HoldDuration:",
        tostring(HoldDuration)
    )
    if fireproximityprompt then
        local Success =
            pcall(function()
                fireproximityprompt(
                    Prompt
                )
            end)
        if Success then
            DebugPrint(
                "fireproximityprompt succeeded"
            )
            return true
        end
    end
    local Success =
        pcall(function()
            Prompt:InputHoldBegin()
            task.wait(
                HoldDuration + 0.1
            )
            Prompt:InputHoldEnd()
        end)
    return Success
end
