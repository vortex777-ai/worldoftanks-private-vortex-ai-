local function HatchEgg(Egg)
    if not Egg
        or not Egg.Parent then
        return false
    end
    if not GetHatchReady(Egg) then
        return false
    end
    local Attachment =
        GetEggPromptAttachment(
            Egg
        )
    local Prompt =
        GetHatchPrompt(
            Egg
        )
    if not Attachment
        or not Prompt then
        return false
    end
    UpdateCharacter()
    if not RootPart then
        return false
    end
    local SavedCFrame =
        RootPart.CFrame
    DebugPrint(
        "Hatching:",
        Egg.Name
    )
    if not MoveToAttachment(
        Attachment,
        HATCH_DISTANCE
    ) then
        RestoreCFrame(
            SavedCFrame
        )
        return false
    end
    task.wait(0.2)
    Prompt =
        GetHatchPrompt(
            Egg
        )
    if not Prompt
        or not Prompt.Enabled then
        RestoreCFrame(
            SavedCFrame
        )
        return false
    end
    ActivatePrompt(
        Prompt
    )
    local Start =
        tick()
    while not Unloaded
        and AutoHatchEnabled do
        if not Egg.Parent then
            DebugPrint(
                "Hatch success:",
                Egg.Name
            )
            RestoreCFrame(
                SavedCFrame
            )
            return true
        end
        if tick() - Start
            >= HATCH_TIMEOUT then
            break
        end
        task.wait(0.05)
    end
    RestoreCFrame(
        SavedCFrame
    )
    return not Egg.Parent
end
local function FindReadyHatchEgg()
    local PlacedEggs = GetPlacedEggs()
    if not PlacedEggs then
        return nil
    end
    for _, Egg in ipairs(PlacedEggs:GetChildren()) do
        if GetHatchReady(Egg) then
            local Prompt = GetHatchPrompt(Egg)
            local Attachment = GetEggPromptAttachment(Egg)
            if Prompt and Attachment and Prompt.Enabled then
                return Egg
            end
        end
    end
    return nil
end
local function ProcessAutoHatch()
    local Egg = FindReadyHatchEgg()
    if Egg then
        PrepareForAction("Hatch")
        task.wait(0.15)
        HatchEgg(Egg)
        ResumeStrengthFarm()
        return
    end
    if AutoHatchStrengthFarmEnabled then
        StartStrengthFarm("Hatch")
    else
        StopStrengthFarm("Hatch")
    end
end
