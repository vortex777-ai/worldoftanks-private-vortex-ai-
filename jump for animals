local function FindBestStealEgg()
    local Stages =
        GetStages()
    if not Stages then
        return nil
    end
    UpdateCharacter()
    if not RootPart then
        return nil
    end
    local BestEgg
    local BestDistance =
        math.huge
    local BestStage
    for _, Stage in ipairs(
        Stages:GetChildren()
    ) do
        if not IsSelected(
            SelectedLocations,
            Stage.Name
        ) then
            continue
        end
        local SpawnedEggs =
            GetSpawnedEggs(
                Stage
            )
        if not SpawnedEggs then
            continue
        end
        for _, Egg in ipairs(
            SpawnedEggs:GetChildren()
        ) do
            if not Egg.Parent then
                continue
            end
            local Rarity =
                Egg:GetAttribute(
                    "Rarity"
                )
            if not Rarity then
                continue
            end
            if not IsSelected(
                SelectedRarities,
                Rarity
            ) then
                continue
            end
            local Prompt =
                GetCollectPrompt(
                    Egg
                )
            if not Prompt
                or not Prompt.Enabled then
                continue
            end
            local Position =
                GetEggPosition(
                    Egg
                )
            if not Position then
                continue
            end
            local Distance =
                (
                    RootPart.Position
                    - Position
                ).Magnitude
            if Distance < BestDistance then
                BestDistance =
                    Distance
                BestEgg =
                    Egg
                BestStage =
                    Stage
            end
        end
    end
    if BestEgg then
        DebugPrint(
            "Best steal egg:",
            BestEgg.Name,
            "Stage:",
            BestStage
                and BestStage.Name
                or "?",
            "Rarity:",
            tostring(
                BestEgg:GetAttribute(
                    "Rarity"
                )
            ),
            "Distance:",
            tostring(
                BestDistance
            )
        )
    else
        DebugPrint(
            "No matching steal egg found"
        )
    end
    return BestEgg
end
