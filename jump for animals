    if not Prompt or not Prompt.Enabled then
        return false
    end
    local Position = GetMutationPromptPosition(Prompt)
    if not Position then
        DebugPrint("AutoMutation: mutation prompt position not found")
        return false
    end
    if not MoveToPosition(Position, 3) then
        return false
    end
    local Success = ActivatePrompt(Prompt)
    DebugPrint("AutoMutation: prompt", tostring(Success), "pet", Tool.Name)
    task.wait(0.35)
    return Success
end
local function ClearAutoMutationQueue()
    AutoMutationQueue = {}
    AutoMutationQueueKey = nil
    AutoMutationQueueIndex = 1
end
local function PrepareAutoMutationQueue()
    local PetKey, PetTools = FindFiveMatchingPets()
    if not PetTools then
        ClearAutoMutationQueue()
        return false
    end
    if AutoMutationQueueKey ~= PetKey or #AutoMutationQueue ~= 5 then
        AutoMutationQueue = PetTools
        AutoMutationQueueKey = PetKey
        AutoMutationQueueIndex = 1
        DebugPrint("AutoMutation: queued 5 pets", PetKey)
    end
    return true
end
local function ProcessAutoMutation()
    local Prompt = GetMutationPrompt()
    if not Prompt then
        ClearAutoMutationQueue()
        StopStrengthFarm("Mutation")
        DebugPrint("AutoMutation: MutationPrompt not found")
        return
    end
    if not PrepareAutoMutationQueue() then
        if AutoMutationStrengthFarmEnabled then
            StartStrengthFarm("Mutation")
        else
            StopStrengthFarm("Mutation")
        end
        return
    end
    local Tool = AutoMutationQueue[AutoMutationQueueIndex]
    if not Tool or not IsToolOwned(Tool) then
        PrepareAutoMutationQueue()
        Tool = AutoMutationQueue[AutoMutationQueueIndex]
    end
    if not Tool or not IsToolOwned(Tool) then
        ClearAutoMutationQueue()
        if AutoMutationStrengthFarmEnabled then
            StartStrengthFarm("Mutation")
        end
        return
    end
    PrepareForAction("Mutation")
    task.wait(0.15)
    Prompt = GetMutationPrompt()
    if not Prompt or not Prompt.Enabled then
        ResumeStrengthFarm()
        return
    end
    local Success = ProcessOneMutationPet(Prompt, Tool)
    if not Success then
        ClearAutoMutationQueue()
        ResumeStrengthFarm()
        return
    end
    AutoMutationQueueIndex += 1
    if AutoMutationQueueIndex > 5 then
        ClearAutoMutationQueue()
    end
    ResumeStrengthFarm()
end
