    StopSquatting()
    StrengthFarmActive = false
    SetAllSquatFlags(false)
    task.wait(0.15)
    return true
end
local function ResumeStrengthFarm()
    if Unloaded or StrengthFarmActive then
        return StrengthFarmActive
    end
    local Mode = GetAnyStrengthFarmMode()
    if not Mode then
        return false
    end
    return StartStrengthFarm(Mode)
end
local function PrepareForAction(Mode)
    StrengthFarmRequests[Mode] = nil
    SetSquatFlag(Mode, false)
    if StrengthFarmActive then
        SuspendStrengthFarm()
    end
end
local function StopStrengthFarm(Mode, Force)
    if Mode ~= "Hatch" and Mode ~= "Steal" and Mode ~= "Mutation" then
        return false
    end
    StrengthFarmRequests[Mode] = nil
    SetSquatFlag(Mode, false)
    if not Force and GetAnyStrengthFarmMode() then
        return true
    end
    if StrengthFarmActive then
        StopSquatting()
        StrengthFarmActive = false
        SetAllSquatFlags(false)
        task.wait(0.15)
    end
    return true
end
local function GetHatchReady(Egg)
    if not Egg then
        return false
    end
    local Value = Egg:GetAttribute("HatchReady")
    if Value ~= nil then
        if typeof(Value) == "boolean" then
            return Value
        end
        if typeof(Value) == "string" then
            return Value:lower() == "true"
        end
        local NumberValue = tonumber(Value)
        if NumberValue ~= nil then
            return NumberValue ~= 0
        end
    end
    local Object = Egg:FindFirstChild("HatchReady", true)
    if Object and Object:IsA("BoolValue") then
        return Object.Value
    end
    return false
end
