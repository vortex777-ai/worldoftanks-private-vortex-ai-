local function StartStrengthFarm(Mode)
    if Mode ~= "Hatch" and Mode ~= "Steal" and Mode ~= "Mutation" then
        return false
    end
    StrengthFarmRequests[Mode] = true
    SetSquatFlag(Mode, true)
    local Plot = FindOwnPlot()
    if not Plot then
        return false
    end
    local Detection = GetSquatDetection(Plot)
    if not Detection then
        DebugPrint("Strength Farm Detector instance not found:", Plot:GetFullName())
        return false
    end
    local Position = GetDetectionPosition(Detection)
    if not Position then
        DebugPrint("Strength Farm position not found:", Detection:GetFullName())
        return false
    end
    UpdateCharacter()
    if not RootPart or not RootPart.Parent then
        return false
    end
    local TargetPosition = Position + Vector3.new(0, 3, 0)
    local Distance = (RootPart.Position - TargetPosition).Magnitude
    if not StrengthFarmActive or Distance > 8 then
        if not MoveToPosition(Position, 3) then
            return false
        end
    end
    local WasActive = StrengthFarmActive
    StrengthFarmActive = true
    SetSquatFlag(Mode, true)
    if not WasActive then
        DebugPrint("Strength Farm started:", Mode, Detection:GetFullName())
    end
    return true
end
local function SuspendStrengthFarm()
    if not StrengthFarmActive then
        return false
