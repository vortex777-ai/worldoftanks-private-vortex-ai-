end
local function PlaceCarriedEgg()
    DebugPrint(
        "========== PLACEMENT START =========="
    )
    local Plot =
        FindOwnPlot()
    if not Plot then
        return false
    end
    local PlacedEggs =
        GetPlacedEggs(
            Plot
        )
    if not PlacedEggs then
        return false
    end
    DebugPrint(
        "Returning to own plot"
    )
    local PlotPosition =
        Plot:GetPivot().Position
    if not MoveToPosition(
        PlotPosition,
        3
    ) then
        return false
    end
    task.wait(0.7)
    local Tool =
        WaitForCarriedEggTool(
            TOOL_TIMEOUT
        )
    if not Tool then
        DebugPrint(
            "Egg Tool not found"
        )
        return false
    end
    local EggId =
        Tool:GetAttribute(
            "EggId"
        )
    if not EggId then
        DebugPrint(
            "EggId missing"
        )
        return false
    end
    DebugPrint(
        "Tool:",
        Tool.Name
    )
    DebugPrint(
        "EggId:",
        tostring(
            EggId
        )
    )
    DebugPrint(
        "EggName:",
        tostring(
            Tool:GetAttribute(
                "EggName"
            )
        )
    )
    DebugPrint(
        "Rarity:",
        tostring(
            Tool:GetAttribute(
                "Rarity"
            )
        )
    )
    local PreviousCount =
        #PlacedEggs:GetChildren()
    if not EquipEggTool(
        Tool
    ) then
        return false
    end
    task.wait(0.3)
    local PlacementPosition =
        FindFreePlacementPosition(
            Plot,
            PlacedEggs
        )
    if not PlacementPosition then
        return false
    end
    local Zone =
        GetPlacementZone(
            Plot
        )
    if not Zone
        or not IsInsidePlacementZone(
            Zone,
            PlacementPosition
        ) then
        DebugPrint(
            "Final placement safety check failed"
        )
        return false
    end
    if not MoveToPlacementPosition(
        PlacementPosition
    ) then
        DebugPrint(
            "Could not move close enough"
        )
        return false
    end
    task.wait(0.25)
    DebugPrint(
        "CarriedEggCount BEFORE:",
        tostring(
            GetCarriedEggCount()
        )
    )
    DebugPrint(
        "PlaceEggRequest EggId:",
        tostring(
            EggId
        )
    )
    DebugPrint(
        "PlaceEggRequest Position:",
        tostring(
            PlacementPosition
        )
    )
    local Success,
        Error =
        pcall(function()
            PlaceEggRequest:FireServer(
                EggId,
                PlacementPosition
            )
        end)
    DebugPrint(
        "PlaceEggRequest:",
        tostring(
            Success
        ),
        tostring(
            Error
        )
    )
    if not Success then
        return false
    end
    local Confirmed =
        WaitForPlacement(
            PlacedEggs,
            PreviousCount
        )
    DebugPrint(
        "Placement confirmed:",
        tostring(
            Confirmed
        )
    )
    DebugPrint(
        "CarriedEggCount AFTER:",
        tostring(
            GetCarriedEggCount()
        )
    )
    return Confirmed
end
local function StealEgg(Egg)
    if not Egg
        or not Egg.Parent then
        return false
    end
    if GetCarriedEggCount() > 0 then
        return false
    end
    local Prompt =
        GetCollectPrompt(
            Egg
        )
    local Attachment =
        GetEggPromptAttachment(
            Egg
        )
    if not Prompt
        or not Attachment then
        return false
    end
    if not Prompt.Enabled then
        return false
    end
    DebugPrint(
        "Stealing:",
        Egg.Name,
        "Rarity:",
        tostring(
            Egg:GetAttribute(
                "Rarity"
            )
        )
    )
    if not MoveToAttachment(
        Attachment,
        STEAL_DISTANCE
    ) then
        return false
    end
    task.wait(0.2)
    Prompt =
        GetCollectPrompt(
            Egg
        )
    if not Prompt
        or not Prompt.Enabled then
        return false
    end
    ActivatePrompt(
        Prompt
    )
    local Start =
        tick()
    while not Unloaded
        and AutoStealEnabled do
        local Count =
            GetCarriedEggCount()
        if Count >= 1 then
            DebugPrint(
                "Steal success:",
                Egg.Name,
                "CarriedEggCount:",
                tostring(
                    Count
                )
            )
            return true
        end
        if tick() - Start
            >= STEAL_TIMEOUT then
            break
        end
        task.wait(0.05)
    end
    DebugPrint(
        "Steal failed:",
        Egg.Name
    )
    return false
end
local function BeginAutoStealSlotWait()
    local PlacedEggs = GetPlacedEggs()
    AutoStealWaitingPlacedEggs = {}
    AutoStealWaitingPlacedEggCount = 0
    if PlacedEggs then
        local Children = PlacedEggs:GetChildren()
        AutoStealWaitingPlacedEggCount = #Children
        for _, Egg in ipairs(Children) do
            AutoStealWaitingPlacedEggs[Egg] = true
        end
    end
    AutoStealWaitingForSlot = true
    DebugPrint(
        "AutoSteal waiting for free slot. PlacedEggs:",
        tostring(AutoStealWaitingPlacedEggCount)
    )
end
local function ResetAutoStealSlotWait()
    AutoStealWaitingForSlot = false
    AutoStealWaitingPlacedEggs = {}
    AutoStealWaitingPlacedEggCount = 0
end
local function IsAutoStealSlotFree()
    if not AutoStealWaitingForSlot then
        return false
    end
    local PlacedEggs = GetPlacedEggs()
    if not PlacedEggs then
        return false
    end
    local CurrentChildren = PlacedEggs:GetChildren()
    if #CurrentChildren < AutoStealWaitingPlacedEggCount then
        DebugPrint(
            "AutoSteal detected free slot by count:",
            tostring(AutoStealWaitingPlacedEggCount),
            "->",
            tostring(#CurrentChildren)
        )
        return true
    end
    for Egg in pairs(AutoStealWaitingPlacedEggs) do
        if not Egg.Parent or not Egg:IsDescendantOf(PlacedEggs) then
            DebugPrint(
                "AutoSteal detected hatched egg:",
                tostring(Egg.Name)
            )
            return true
        end
    end
    return false
end
local function HandleFailedAutoStealPlacement()
    if AutoStealStrengthFarmEnabled then
        BeginAutoStealSlotWait()
        StartStrengthFarm("Steal")
    else
        ResetAutoStealSlotWait()
        StopStrengthFarm("Steal")
    end
end
local function TryPlaceAutoStealEgg()
    if AutoStealWaitingForSlot then
        if not IsAutoStealSlotFree() then
            if AutoStealStrengthFarmEnabled then
                StartStrengthFarm("Steal")
            end
            return false
        end
        DebugPrint("Free egg slot detected. Retrying placement")
        PrepareForAction("Steal")
        task.wait(0.15)
        local Success = PlaceCarriedEgg()
        if Success then
            ResetAutoStealSlotWait()
            return true
        end
        HandleFailedAutoStealPlacement()
        return false
    end
    PrepareForAction("Steal")
    task.wait(0.15)
    local Success = PlaceCarriedEgg()
    if Success then
        ResetAutoStealSlotWait()
        return true
    end
    HandleFailedAutoStealPlacement()
    return false
end
local function ProcessAutoSteal()
    if not AutoStealEnabled then
        StopStrengthFarm("Steal")
        return
    end
    local Tool = FindCarriedEggTool()
    local Carried = GetCarriedEggCount() > 0
    if Tool or Carried then
        TryPlaceAutoStealEgg()
        return
    end
    if AutoStealWaitingForSlot then
        ResetAutoStealSlotWait()
    end
    local Egg = FindBestStealEgg()
    if not Egg then
        if AutoStealStrengthFarmEnabled then
            StartStrengthFarm("Steal")
        else
            StopStrengthFarm("Steal")
        end
        return
    end
    PrepareForAction("Steal")
    task.wait(0.15)
    if not StealEgg(Egg) then
        ResumeStrengthFarm()
        return
    end
    task.wait(0.2)
    if GetCarriedEggCount() <= 0 and not FindCarriedEggTool() then
        DebugPrint("No carried egg detected")
        ResumeStrengthFarm()
        return
    end
    TryPlaceAutoStealEgg()
end
local function GetMutationPrompt()
    local Map = Workspace:FindFirstChild("Map")
    if not Map then
        return nil
    end
    local Mutations = Map:FindFirstChild("Mutations")
    if not Mutations then
        return nil
    end
    local Prompt = Mutations:FindFirstChild("MutationPrompt", true)
    if Prompt and Prompt:IsA("ProximityPrompt") then
