local function FindFreePlacementPosition(
    Plot,
    PlacedEggs
)
    UpdateCharacter()
    if not RootPart then
        return nil
    end
    local Zone =
        GetPlacementZone(
            Plot
        )
    if not Zone then
        return nil
    end
    local Origin =
        RootPart.Position
    local PlacementY =
        Zone.Position.Y
        - Zone.Size.Y / 2
        + 0.05
    local HalfX =
        Zone.Size.X / 2
        - PLACEMENT_EDGE_MARGIN
    local HalfZ =
        Zone.Size.Z / 2
        - PLACEMENT_EDGE_MARGIN
    local Candidates = {}
    for X = -HalfX,
        HalfX,
        PLACEMENT_SEARCH_STEP do
        for Z = -HalfZ,
            HalfZ,
            PLACEMENT_SEARCH_STEP do
            local Candidate =
                Zone.CFrame:PointToWorldSpace(
                    Vector3.new(
                        X,
                        -Zone.Size.Y / 2
                            + 0.05,
                        Z
                    )
                )
            Candidate =
                Vector3.new(
                    Candidate.X,
                    PlacementY,
                    Candidate.Z
                )
            if IsInsidePlacementZone(
                Zone,
                Candidate
            ) then
                local Distance =
                    (
                        Vector2.new(
                            Candidate.X,
                            Candidate.Z
                        )
                        - Vector2.new(
                            Origin.X,
                            Origin.Z
                        )
                    ).Magnitude
                table.insert(
                    Candidates,
                    {
                        Position = Candidate,
                        Distance = Distance
                    }
                )
            end
        end
    end
    table.sort(
        Candidates,
        function(A, B)
            return A.Distance
                < B.Distance
        end
    )
    local Candidate =
        Candidates[1]
    if not Candidate then
        DebugPrint(
            "No placement candidate found"
        )
        return nil
    end
    DebugPrint(
        "Free placement position:",
        tostring(
            Candidate.Position
        ),
        "Player distance:",
        tostring(
            Candidate.Distance
        )
    )
    return Candidate.Position
end
local function MoveToPlacementPosition(
    Position
)
    UpdateCharacter()
    if not RootPart
        or not RootPart.Parent then
        return false
