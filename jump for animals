local function HideBottomPlayerInfo()
    if not Window or not Window.Items then
        return
    end

    local SidebarItem = Window.Items["Sidebar"]
    local PagesItem = Window.Items["Pages"]
    local Sidebar = SidebarItem and SidebarItem.Instance
    local Pages = PagesItem and PagesItem.Instance
    if not Sidebar then
        return
    end

    for _, Child in ipairs(Sidebar:GetChildren()) do
        if Child:IsA("Frame") then
            local IsBottomTab = false
            local Position = Child.Position
            local Size = Child.Size
            if Position.Y.Scale == 1 and Position.Y.Offset >= 15 and Position.Y.Offset <= 25 and Size.Y.Scale == 0 and Size.Y.Offset >= 100 then
                IsBottomTab = true
            end
            if not IsBottomTab then
                for _, Descendant in ipairs(Child:GetDescendants()) do
                    if Descendant:IsA("TextLabel") or Descendant:IsA("TextButton") then
                        local Text = tostring(Descendant.Text or "")
                        if Text == "Expires:" or Text:find("Expires:", 1, true) or Text == LocalPlayer.Name then
                            IsBottomTab = true
                            break
                        end
                    end
                end
            end
            if IsBottomTab then
                Child:Destroy()
            end
        end
    end

    for _, Child in ipairs(Sidebar:GetChildren()) do
        if Child:IsA("Frame") then
            local Position = Child.Position
            local Size = Child.Size
            if Size.Y.Scale == 0 and Size.Y.Offset == 1 and Position.Y.Scale == 1 and Position.Y.Offset <= -80 then
                Child:Destroy()
            end
        end
    end

    if Pages and Pages.Parent then
        Pages.Size = UDim2.new(1, -16, 1, -85)
    end
end

