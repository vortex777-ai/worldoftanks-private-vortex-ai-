end
local function GetInstancePosition(Object)
    if not Object or not Object.Parent then
        return nil
    end
    local Success, CFrameValue = pcall(function()
        return Object.CFrame
    end)
    if Success and typeof(CFrameValue) == "CFrame" then
        return CFrameValue.Position
    end
    if Object:IsA("Attachment") then
        return Object.WorldPosition
    end
    if Object:IsA("BasePart") then
        return Object.Position
    end
    if Object:IsA("Model") then
        return Object:GetPivot().Position
    end
    local Part = Object:FindFirstChildWhichIsA("BasePart", true)
    if Part then
        return Part.Position
    end
    return nil
end
local function GetMutationPromptPosition(Prompt)
    if not Prompt then
        return nil
    end
    local Parent = Prompt.Parent
    local Position = GetInstancePosition(Parent)
    if Position then
        return Position
    end
    local Ancestor = Parent
    for _ = 1, 6 do
        if not Ancestor then
            break
        end
        Position = GetInstancePosition(Ancestor)
        if Position then
            return Position
        end
        Ancestor = Ancestor.Parent
    end
    return nil
end
local function GetPetToolKey(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return nil
    end
    local Attributes = {
        "PetName",
        "Pet",
        "Name",
        "DisplayName"
    }
    for _, AttributeName in ipairs(Attributes) do
        local Value = Tool:GetAttribute(AttributeName)
        if Value ~= nil and tostring(Value) ~= "" then
            return tostring(Value)
        end
    end
    local ValueObject = Tool:FindFirstChild("PetName", true)
    if ValueObject and ValueObject:IsA("StringValue") and ValueObject.Value ~= "" then
        return ValueObject.Value
    end
    return Tool.Name
end
local function GetInventoryPetTools()
    local Result = {}
    local Seen = {}
    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if Backpack then
        for _, Object in ipairs(Backpack:GetChildren()) do
            if Object:IsA("Tool") and not Seen[Object] then
                Seen[Object] = true
                table.insert(Result, Object)
            end
        end
    end
    UpdateCharacter()
    if Character then
        for _, Object in ipairs(Character:GetChildren()) do
            if Object:IsA("Tool") and not Seen[Object] then
                Seen[Object] = true
                table.insert(Result, Object)
            end
        end
    end
    return Result
end
local function FindFiveMatchingPets()
    local Groups = {}
    for _, Tool in ipairs(GetInventoryPetTools()) do
        local Key = GetPetToolKey(Tool)
        if Key then
            Groups[Key] = Groups[Key] or {}
            table.insert(Groups[Key], Tool)
        end
    end
    local BestKey
    local BestTools
    for Key, Tools in pairs(Groups) do
        if #Tools >= 5 and (not BestTools or #Tools > #BestTools) then
            BestKey = Key
            BestTools = Tools
        end
    end
    if not BestTools then
        return nil, nil
    end
    local Selected = {}
    for Index = 1, 5 do
        Selected[Index] = BestTools[Index]
    end
    return BestKey, Selected
end
local function IsToolOwned(Tool)
    if not Tool then
        return false
    end
    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    return (Backpack and Tool:IsDescendantOf(Backpack)) or (Character and Tool:IsDescendantOf(Character))
end
local function EquipMutationPet(Tool)
    if not Tool or not IsToolOwned(Tool) then
        return false
    end
    UpdateCharacter()
    if not Humanoid or not Character then
        return false
    end
    if not Tool:IsDescendantOf(Character) then
        local Success = pcall(function()
            Humanoid:EquipTool(Tool)
        end)
        if not Success then
            return false
        end
    end
    local Start = tick()
    while not Unloaded and tick() - Start < 2 do
        if Tool:IsDescendantOf(Character) then
            return true
        end
        task.wait(0.05)
    end
    return Tool:IsDescendantOf(Character)
end
local function ProcessOneMutationPet(Prompt, Tool)
    if not Prompt or not Prompt.Parent or not Tool then
        return false
    end
    if not EquipMutationPet(Tool) then
        DebugPrint("AutoMutation: failed to equip pet", Tool and Tool.Name)
        return false
    end
    task.wait(0.15)
