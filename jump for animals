local function BuildRarityList()
    local Result = {}
    local Assets =
        ReplicatedStorage:FindFirstChild(
            "Assets"
        )
    if not Assets then
        return Result
    end
    local Rarities =
        Assets:FindFirstChild(
            "Rarities"
        )
    if not Rarities then
        return Result
    end
    for _, Object in ipairs(
        Rarities:GetChildren()
    ) do
        table.insert(
            Result,
            Object.Name
        )
