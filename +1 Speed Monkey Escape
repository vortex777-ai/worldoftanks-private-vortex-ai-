local function GetBestAvailableTrail()
    local Data = GetPlayerData()

    if not Data or not TrailsConfig then
        return nil
    end

    local UnlockedTrails = Data:FindFirstChild("UnlockedTrails")
    local Wins = Data:FindFirstChild("Wins")

    if not UnlockedTrails or not Wins then
        return nil
    end

    local currentMulti = GetCurrentTrailMulti()
    local bestTrail = nil
    local bestMulti = currentMulti
    local bestPrice = nil

    for trailName, trailData in pairs(TrailsConfig) do
        if type(trailData) == "table" then
            local multi = tonumber(trailData.Multi) or 0
            local price = trailData.Price
            local unlocked = UnlockedTrails:FindFirstChild(trailName) ~= nil

            if not unlocked and multi > bestMulti and price ~= nil then
