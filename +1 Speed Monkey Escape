local function BuyCharmSlot(slotNumber)
    local CharmShop = GetCharmShopData()
    if not CharmShop then return false end

    local Slot = CharmShop:FindFirstChild("Slot" .. tostring(slotNumber))
    local Bought = CharmShop:FindFirstChild("Bought" .. tostring(slotNumber))

    if not Slot or not Bought then return false end
    if Slot.Value == "" or Bought.Value then return false end

    local CharmItems = GetWorldCharmItems()
    if not CharmItems then return false end

    local charmData = CharmItems[Slot.Value]
    if not charmData then return false end

    if not IsCharmRarityAllowed(charmData.Rarity) then
        return false
    end

    if not CanAffordCharm(charmData) then
        return false
    end

    local itemName = tostring(Slot.Value)

    local purchaseSuccess = pcall(function()
        ReplicatedStorage
            :WaitForChild("Remotes")
            :WaitForChild("BuyCharm")
            :FireServer(slotNumber)
    end)

    if not purchaseSuccess then
        return false
    end

    if AutoBuyDebug then
        print("Purchased item: " .. itemName)
    end

    task.wait(0.25)
    EquipBestCharms()

    return true
end

local function ProcessAutoBuy()
    local CharmShop = GetCharmShopData()
    if not CharmShop then return end

    for slotNumber = 1, 3 do
        if not AutoBuyEnabled then break end

        BuyCharmSlot(slotNumber)
        task.wait(0.25)
    end
end

