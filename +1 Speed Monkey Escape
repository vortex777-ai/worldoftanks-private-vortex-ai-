-- ==================== ANTI DEATH ====================

local AntiDeathEnabled = false
local AntiDeathConnection = nil
local AntiDeathHealthConnection = nil

local function SetupAntiDeath()
    if AntiDeathConnection then
        AntiDeathConnection:Disconnect()
        AntiDeathConnection = nil
    end

    if AntiDeathHealthConnection then
        AntiDeathHealthConnection:Disconnect()
        AntiDeathHealthConnection = nil
    end

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then return end

    AntiDeathConnection =
        RunService.Heartbeat:Connect(function()
            if not AntiDeathEnabled then
                return
            end

            local currentCharacter = LocalPlayer.Character
            if not currentCharacter then return end

            local currentHumanoid =
                currentCharacter:FindFirstChildOfClass("Humanoid")

            if not currentHumanoid then return end

            pcall(function()
                currentHumanoid:SetStateEnabled(
                    Enum.HumanoidStateType.FallingDown,
                    false
                )

                currentHumanoid:SetStateEnabled(
                    Enum.HumanoidStateType.Ragdoll,
                    false
                )

                currentHumanoid:SetStateEnabled(
                    Enum.HumanoidStateType.Physics,
                    false
                )

                currentHumanoid:SetStateEnabled(
                    Enum.HumanoidStateType.Dead,
                    false
                )
            end)

            if currentHumanoid.Health <= 0 then
                pcall(function()
                    currentHumanoid.Health =
                        currentHumanoid.MaxHealth
                end)
            end
        end)

    AntiDeathHealthConnection =
        humanoid.HealthChanged:Connect(function(health)
            if not AntiDeathEnabled then
                return
            end

            if health <= 0 then
                pcall(function()
                    humanoid.Health =
                        humanoid.MaxHealth
                end)
            end
        end)
end

local function StopAntiDeath()
    AntiDeathEnabled = false

    if AntiDeathConnection then
        AntiDeathConnection:Disconnect()
        AntiDeathConnection = nil
    end

    if AntiDeathHealthConnection then
        AntiDeathHealthConnection:Disconnect()
        AntiDeathHealthConnection = nil
    end

    local character = LocalPlayer.Character

    if character then
        local humanoid =
            character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            pcall(function()
                humanoid:SetStateEnabled(
                    Enum.HumanoidStateType.FallingDown,
                    true
                )

                humanoid:SetStateEnabled(
                    Enum.HumanoidStateType.Ragdoll,
                    true
                )

                humanoid:SetStateEnabled(
                    Enum.HumanoidStateType.Physics,
                    true
                )

                humanoid:SetStateEnabled(
                    Enum.HumanoidStateType.Dead,
                    true
                )
            end)
        end
    end
end

PlayerSection:Toggle({
    Name = "AntiDeath",
    Flag = "AntiDeath",
    Default = false,
    Callback = function(state)
        AntiDeathEnabled = state

        if state then
            SetupAntiDeath()
        else
            StopAntiDeath()
        end
    end,
})

