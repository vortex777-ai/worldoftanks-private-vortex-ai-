    if not Data or not TrailsConfig then
        return 0
    end

    local EquippedTrail = Data:FindFirstChild("EquippedTrail")

    if not EquippedTrail then
        return 0
    end

    local currentTrailName = EquippedTrail.Value

    if currentTrailName == nil or currentTrailName == "" then
        return 0
    end

    local currentTrail = TrailsConfig[currentTrailName]

    if not currentTrail then
        return 0
    end

    return tonumber(currentTrail.Multi) or 0
