local function GetCharmRarityValue(rarity)
    return CharmRarityOrder[tostring(rarity)] or 0
end

local function IsCharmRarityAllowed(rarity)
    return GetCharmRarityValue(rarity) >= GetCharmRarityValue(SelectedMinimumRarity)
end

local function GetCharmShopData()
    local Data = LocalPlayer:FindFirstChild("Data")
    if not Data then return nil end

    local CharmShop = Data:FindFirstChild("CharmShop")
    if not CharmShop then return nil end

    local WorldValue = Data:FindFirstChild("World")
    if not WorldValue then return nil end

    return CharmShop:FindFirstChild("World" .. tostring(WorldValue.Value))
end

local function GetCharmConfig()
    local success, result = pcall(function()
        return require(
            ReplicatedStorage
                :WaitForChild("Config")
                :WaitForChild("Charms")
        )
    end)

    if success then
        return result
    end

    return nil
end

local CharmsConfig = GetCharmConfig()

local function GetWorldCharmItems()
    if not CharmsConfig then return nil end

    local Data = LocalPlayer:FindFirstChild("Data")
    if not Data then return nil end

    local WorldValue = Data:FindFirstChild("World")
    if not WorldValue then return nil end

    local worldItems =
        CharmsConfig.Items
        and CharmsConfig.Items["World" .. tostring(WorldValue.Value)]

    if not worldItems then return nil end

    local Secret = CharmsConfig.Items.Secret
    if not Secret then return worldItems end

    local result = {}

    for name, charmData in pairs(worldItems) do
        result[name] = charmData
    end

    for name, charmData in pairs(Secret) do
        result[name] = charmData
    end

    return result
end

local function CanAffordCharm(charmData)
    if not charmData then return false end

    local Data = LocalPlayer:FindFirstChild("Data")
    if not Data then return false end

    local Wins = Data:FindFirstChild("Wins")
    if not Wins then return false end

    local success, result = pcall(function()
        local BigNum = require(
            ReplicatedStorage
                :WaitForChild("Util")
                :WaitForChild("BigNum")
        )

        return BigNum.GreaterEqual(Wins, charmData.Price)
    end)

    return success and result == true
end

