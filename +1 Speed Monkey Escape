local AutoAuraEnabled = false
local AutoAuraConnectionId = 0
local AurasConfig

pcall(function()
    AurasConfig = require(
        ReplicatedStorage
            :WaitForChild("Config")
            :WaitForChild("Auras")
    )
end)

local function GetAuraPlayerData()
    return LocalPlayer:FindFirstChild("Data")
end

local function GetCurrentAuraMulti()
    local Data = GetAuraPlayerData()

    if not Data or not AurasConfig then
        return 0
    end

    local EquippedAura = Data:FindFirstChild("EquippedAura")

    if not EquippedAura then
        return 0
    end

    local currentAuraName = EquippedAura.Value

    if currentAuraName == nil or currentAuraName == "" then
        return 0
    end

    local currentAura = AurasConfig[currentAuraName]

    if not currentAura then
        return 0
    end

    return tonumber(currentAura.Multi) or 0
end

local function GetBestAvailableAura()
    local Data = GetAuraPlayerData()

    if not Data or not AurasConfig then
        return nil
    end

    local UnlockedAuras = Data:FindFirstChild("UnlockedAuras")
    local Wins = Data:FindFirstChild("Wins")

    if not UnlockedAuras or not Wins then
        return nil
    end

    local currentMulti = GetCurrentAuraMulti()
    local bestAura = nil
    local bestMulti = currentMulti

    for auraName, auraData in pairs(AurasConfig) do
        if type(auraData) == "table" then
            local multi = tonumber(auraData.Multi) or 0
            local price = auraData.Price
            local unlocked = UnlockedAuras:FindFirstChild(auraName) ~= nil

            if not unlocked and multi > bestMulti and price ~= nil then
                local canAfford = false

                pcall(function()
                    local BigNum = require(
                        ReplicatedStorage
                            :WaitForChild("Util")
                            :WaitForChild("BigNum")
                    )

                    canAfford = BigNum.GreaterEqual(Wins, price)
                end)

                if canAfford then
                    bestAura = auraName
                    bestMulti = multi
                end
            end
        end
    end

    return bestAura, bestMulti
end

local function ProcessAutoAura()
    local auraName = GetBestAvailableAura()

    if not auraName then
        return
    end

    local Remotes = ReplicatedStorage:WaitForChild("Remotes")
    local BuyAura = Remotes:WaitForChild("BuyAura")
    local EquipAura = Remotes:WaitForChild("EquipAura")

    local success = pcall(function()
        BuyAura:FireServer(auraName)
    end)

    if success then
        task.wait(0.25)

        pcall(function()
            EquipAura:FireServer(auraName)
        end)
    end
end

local function StartAutoAura()
    AutoAuraConnectionId = AutoAuraConnectionId + 1
    local myConnectionId = AutoAuraConnectionId

    task.spawn(function()
        while AutoAuraEnabled and myConnectionId == AutoAuraConnectionId do
            ProcessAutoAura()
            task.wait(1)
        end
    end)
end

