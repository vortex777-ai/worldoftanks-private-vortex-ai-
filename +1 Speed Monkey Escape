local AutoFuseSection = AutoFusePage:Section({
    Name = "Auto Fuse",
    Side = 1,
})

local AutoFuseEnabled = false
local AutoFuseConnectionId = 0
local AutoFuseDelay = 0.5
local SelectedAutoFuseEquipPreset = "Wins"

local function GetCharmMutation(charm)
    local mutation = charm:GetAttribute("Mutation")

    if mutation == nil then
        return "Normal"
    end

    mutation = tostring(mutation)

    if mutation == "" or mutation == "None" then
        return "Normal"
    end

    return mutation
end

local function GetCharmStars(charm)
    return tonumber(charm:GetAttribute("Stars")) or 0
end

local function IsCharmLocked(charm)
    return charm:GetAttribute("Locked") == true
end

local function GetCharmName(charm)
    local charmName = charm:GetAttribute("CharmName")

    if charmName == nil then
        return nil
    end

    charmName = tostring(charmName)

    if charmName == "" then
        return nil
    end

    return charmName
end

local function GetFuseGroups()
    local Data = LocalPlayer:FindFirstChild("Data")
    if not Data then return {} end

    local Charms = Data:FindFirstChild("Charms")
    if not Charms then return {} end

    local groups = {}

    for _, charm in ipairs(Charms:GetChildren()) do
        if charm:IsA("Folder") and not IsCharmLocked(charm) then
            local charmName = GetCharmName(charm)

            if charmName then
                local stars = GetCharmStars(charm)
                local mutation = GetCharmMutation(charm)

                local groupKey =
                    charmName
                    .. "|"
                    .. tostring(stars)
                    .. "|"
                    .. mutation

                if not groups[groupKey] then
                    groups[groupKey] = {
                        CharmName = charmName,
                        Stars = stars,
                        Mutation = mutation,
                        UUIDs = {},
                    }
                end

                table.insert(groups[groupKey].UUIDs, charm.Name)
            end
        end
    end

    return groups
end

local function EquipBestFusePreset()
    pcall(function()
        ReplicatedStorage
            :WaitForChild("Remotes")
            :WaitForChild("EquipBestCharms")
            :FireServer(SelectedAutoFuseEquipPreset)
    end)
end

local function FuseThreeCharms(uuid1, uuid2, uuid3)
    if not uuid1 or not uuid2 or not uuid3 then
        return false
    end

    local success = pcall(function()
        ReplicatedStorage
            :WaitForChild("Remotes")
            :WaitForChild("FuseCharms")
            :FireServer({
                uuid1,
                uuid2,
                uuid3,
            })
    end)

    return success
end

local function ProcessAutoFuse()
    local groups = GetFuseGroups()

    for _, group in pairs(groups) do
        if not AutoFuseEnabled then
            break
        end

        if #group.UUIDs >= 3 then
            local uuid1 = group.UUIDs[1]
            local uuid2 = group.UUIDs[2]
            local uuid3 = group.UUIDs[3]

            local success =
                FuseThreeCharms(uuid1, uuid2, uuid3)

            if success then
                task.wait(AutoFuseDelay)
                EquipBestFusePreset()
            end

            break
        end
    end
end

local function StartAutoFuse()
    AutoFuseConnectionId = AutoFuseConnectionId + 1
    local myConnectionId = AutoFuseConnectionId

    task.spawn(function()
        while AutoFuseEnabled and myConnectionId == AutoFuseConnectionId do
            ProcessAutoFuse()
            task.wait(AutoFuseDelay)
        end
    end)
end

