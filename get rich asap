local function RemoveStellarUserInfo(Window)
    pcall(function()
        if not Window
            or not Window.Items
            or not Window.Items["Sidebar"]
            or not Window.Items["Sidebar"].Instance
        then
            return
        end

        local Sidebar = Window.Items["Sidebar"].Instance
        local RemoveList = {}

        for _, Child in ipairs(Sidebar:GetChildren()) do
            if Child:IsA("Frame") then
                local Remove = false

                if Child.Position.Y.Scale == 1
                    and Child.Position.Y.Offset == 20
                    and Child.Size.Y.Offset == 105
                then
                    Remove = true
                end

                if not Remove then
                    for _, Descendant in ipairs(Child:GetDescendants()) do
                        if Descendant:IsA("TextLabel") then
                            if Descendant.Text == LocalPlayer.Name
                                or Descendant.Text == "Expires:"
                            then
                                Remove = true
                                break
                            end
                        end
                    end
                end

                if Remove then
                    table.insert(RemoveList, Child)
                end
            end
        end

        for _, Object in ipairs(RemoveList) do
            pcall(function()
                Object:Destroy()
            end)
        end

        for _, Child in ipairs(Sidebar:GetChildren()) do
            if Child:IsA("Frame")
                and Child.Size.X.Scale == 1
                and Child.Size.X.Offset == 0
                and Child.Size.Y.Scale == 0
                and Child.Size.Y.Offset == 1
                and Child.Position.Y.Scale == 1
                and Child.Position.Y.Offset == -85
            then
                pcall(function()
                    Child:Destroy()
                end)
            end
        end
    end)
end

local function ApplyMovement()
    local _, CurrentHumanoid = GetCharacter()

    if not CurrentHumanoid then
        return
    end

    if State.SpeedHack then
        CurrentHumanoid.WalkSpeed = State.WalkSpeed
    else
        CurrentHumanoid.WalkSpeed = SavedWalkSpeed
    end

    if State.JumpHack then
        CurrentHumanoid.UseJumpPower = true
        CurrentHumanoid.JumpPower = State.JumpPower
    else
        CurrentHumanoid.UseJumpPower = SavedUseJumpPower
        CurrentHumanoid.JumpPower = SavedJumpPower
    end
end

