RunService.RenderStepped:Connect(function()
    if not State.Fly then
        return
    end

    local _, _, CurrentRootPart = GetCharacter()

    if not CurrentRootPart then
        return
    end

    if not FlyVelocity or not FlyVelocity.Parent then
        StartFly()
        return
    end

    local Camera = Workspace.CurrentCamera

    if not Camera then
        return
    end

    local Direction = Vector3.zero

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        Direction += Camera.CFrame.LookVector
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        Direction -= Camera.CFrame.LookVector
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        Direction -= Camera.CFrame.RightVector
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        Direction += Camera.CFrame.RightVector
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        Direction += Vector3.yAxis
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    then
        Direction -= Vector3.yAxis
    end

    if Direction.Magnitude > 0 then
        Direction = Direction.Unit
    end

    FlyVelocity.Velocity = Direction * State.FlySpeed

    FlyGyro.CFrame = CFrame.lookAt(
        CurrentRootPart.Position,
        CurrentRootPart.Position + Camera.CFrame.LookVector
    )
end)

local function ActivatePrompt(Prompt)
    if not Prompt or not Prompt:IsA("ProximityPrompt") then
        return false
    end

    if typeof(fireproximityprompt) ~= "function" then
        return false
    end

    return pcall(function()
        fireproximityprompt(Prompt, 1)
    end)
end

local function GetPrompt(Object, PromptName)
    if not Object then
        return nil
    end

    if PromptName then
        local Direct = Object:FindFirstChild(PromptName, true)

        if Direct and Direct:IsA("ProximityPrompt") then
            return Direct
        end
    end

    for _, Descendant in ipairs(Object:GetDescendants()) do
        if Descendant:IsA("ProximityPrompt") then
            return Descendant
        end
    end

    return nil
end

local function GetObjectCFrame(Object)
    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.CFrame
    end

    if Object:IsA("Model") then
        return Object:GetPivot()
    end

    for _, Descendant in ipairs(Object:GetDescendants()) do
        if Descendant:IsA("BasePart") then
            return Descendant.CFrame
        end
    end

    return nil
end

local function TeleportTo(ObjectOrCFrame)
    local _, _, CurrentRootPart = GetCharacter()

    if not CurrentRootPart then
        return false
    end

    local TargetCFrame

    if typeof(ObjectOrCFrame) == "CFrame" then
        TargetCFrame = ObjectOrCFrame
    else
        TargetCFrame = GetObjectCFrame(ObjectOrCFrame)
    end

    if not TargetCFrame then
        return false
    end

    return pcall(function()
        CurrentRootPart.CFrame =
            TargetCFrame + Vector3.new(0, 2.5, 0)
    end)
end

