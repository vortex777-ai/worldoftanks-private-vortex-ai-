local function PerformInvestmentAction(
    Action,
    Data
)
    if not InvestmentPerformAction then
        return false
    end

    if not InvestmentPerformAction:IsA(
        "RemoteFunction"
    ) then
        return false
    end

    local Success,
        Result1,
        Result2 =
        pcall(function()
            return InvestmentPerformAction:
                InvokeServer(
                    Action,
                    Data or {}
                )
        end)

    if not Success then
        return false,
            Result1
    end

    return Result1,
        Result2
end

local function GetActiveInvestmentSeconds(
    Data
)
    if not Data
        or type(Data) ~= "table"
    then
        return nil
    end

    local ActiveInvestment =
        Data.ActiveInvestment

    if not ActiveInvestment then
        return nil
    end

    local SecondsLeft =
        tonumber(
            ActiveInvestment.SecondsLeft
        )

    if SecondsLeft
        and SecondsLeft >= 0
    then
        return SecondsLeft
    end

    return nil
end

local function AutoInvestOnce()
    if not InvestmentConfig
        or not InvestmentRequestData
        or not InvestmentPerformAction
    then
        return false
    end

    if not State.InvestmentTierId
        or not State.InvestmentDurationId
    then
        return false
    end

    local Data =
        GetInvestmentData()

    if not Data then
        return false
    end

    if Data.ActiveInvestment then
        if Data.ActiveInvestment.Ready then
            PerformInvestmentAction(
                "Collect",
                {}
            )

            task.wait(0.5)

            Data =
                GetInvestmentData()

            if not Data then
                return false
            end
        else
            return true
        end
    end

    if not Data.ActiveInvestment then
        local Success =
            PerformInvestmentAction(
                "Invest",
                {
                    TierId =
                        State.InvestmentTierId,

                    DurationId =
                        State.InvestmentDurationId
                }
            )

        if not Success then
            return false
        end

        task.wait(0.5)

        return true
    end

    return true
end

local function StartAutoInvest()
    AutoInvestCycle += 1

    local CurrentCycle =
        AutoInvestCycle

    task.spawn(function()
        while State.AutoInvest
            and CurrentCycle
                == AutoInvestCycle
        do
            local Data =
                GetInvestmentData()

            if not Data then
                task.wait(5)
                continue
            end

            if Data.ActiveInvestment then
                if Data.ActiveInvestment.Ready then
                    pcall(function()
                        PerformInvestmentAction(
                            "Collect",
                            {}
                        )
                    end)

                    task.wait(0.5)

                    pcall(function()
                        AutoInvestOnce()
                    end)
                else
                    local SecondsLeft =
                        GetActiveInvestmentSeconds(
                            Data
                        )

                    if SecondsLeft
                        and SecondsLeft > 0
                    then
                        local EndTime =
                            os.clock()
                            + SecondsLeft

                        while State.AutoInvest
                            and CurrentCycle
                                == AutoInvestCycle
                            and os.clock()
                                < EndTime
                        do
                            local Remaining =
                                EndTime
                                - os.clock()

                            task.wait(
                                math.min(
                                    Remaining,
                                    1
                                )
                            )
                        end
                    else
                        task.wait(5)
                    end
                end
            else
                local Success = false

                pcall(function()
                    Success =
                        AutoInvestOnce()
                end)

                if Success then
                    task.wait(0.5)

                    local NewData =
                        GetInvestmentData()

                    local SecondsLeft

                    if NewData then
                        SecondsLeft =
                            GetActiveInvestmentSeconds(
                                NewData
                            )
                    end

                    if SecondsLeft
                        and SecondsLeft > 0
                    then
                        local EndTime =
                            os.clock()
                            + SecondsLeft

                        while State.AutoInvest
                            and CurrentCycle
                                == AutoInvestCycle
                            and os.clock()
                                < EndTime
                        do
                            local Remaining =
                                EndTime
                                - os.clock()

                            task.wait(
                                math.min(
                                    Remaining,
                                    1
                                )
                            )
                        end
                    else
                        task.wait(5)
                    end
                else
                    task.wait(5)
                end
            end

            if not State.AutoInvest
                or CurrentCycle
                    ~= AutoInvestCycle
            then
                break
            end
        end
    end)
end

