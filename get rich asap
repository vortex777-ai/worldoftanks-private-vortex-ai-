local function StartCashCollect(
    StateName,
    EventsFolderName
)
    task.spawn(function()
        while State[StateName] do
            pcall(function()
                local EventsFolder =
                    GetRemoteFolder(
                        EventsFolderName
                    )

                if not EventsFolder then
                    return
                end

                local PerformAction =
                    EventsFolder:
                        FindFirstChild(
                            "PerformAction"
                        )

                if not PerformAction then
                    PerformAction =
                        EventsFolder:
                            FindFirstChild(
                                "PerformAction",
                                true
                            )
                end

                if not PerformAction then
                    return
                end

                if not PerformAction:IsA(
                    "RemoteFunction"
                ) then
                    return
                end

                local args = {
                    "CashOut"
                }

                PerformAction:
                    InvokeServer(
                        unpack(args)
                    )
            end)

            task.wait(5)
        end
    end)
end

