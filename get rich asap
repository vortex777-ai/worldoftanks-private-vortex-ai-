local function FormatMoney(Value)
    Value =
        tonumber(Value)
        or 0

    if Value >= 1e12 then
        return string.format(
            "$%.2fT",
            Value / 1e12
        )
    elseif Value >= 1e9 then
        return string.format(
            "$%.2fB",
            Value / 1e9
        )
    elseif Value >= 1e6 then
        return string.format(
            "$%.2fM",
            Value / 1e6
        )
    elseif Value >= 1e3 then
        return string.format(
            "$%.2fK",
            Value / 1e3
        )
    end

    return "$"
        .. tostring(Value)
end

local function BuildInvestmentOptions()
    table.clear(
        InvestmentAmountItems
    )

    table.clear(
        InvestmentAmountMap
    )

    table.clear(
        InvestmentPercentItems
    )

    table.clear(
        InvestmentPercentMap
    )

    if not InvestmentConfig then
        return
    end

    if type(
        InvestmentConfig.Tiers
    ) == "table"
    then
        for _, Tier in ipairs(
            InvestmentConfig.Tiers
        ) do
            if type(Tier) == "table"
                and Tier.Id ~= nil
            then
                local Label =
                    FormatMoney(
                        Tier.Amount
                    )

                table.insert(
                    InvestmentAmountItems,
                    Label
                )

                InvestmentAmountMap[
                    Label
                ] = Tier.Id

                if not State.InvestmentTierId then
                    State.InvestmentTierId =
                        Tier.Id
                end
            end
        end
    end

    if type(
        InvestmentConfig.Durations
    ) == "table"
    then
        for _, Duration in ipairs(
            InvestmentConfig.Durations
        ) do
            if type(Duration) == "table"
                and Duration.Id ~= nil
            then
                local ProfitPercent =
                    tonumber(
                        Duration.ProfitPercent
                    )
                    or 0

                local Label =
                    "+"
                    .. tostring(
                        ProfitPercent
                    )
                    .. "%"

                table.insert(
                    InvestmentPercentItems,
                    Label
                )

                InvestmentPercentMap[
                    Label
                ] = Duration.Id

                if not State.InvestmentDurationId then
                    State.InvestmentDurationId =
                        Duration.Id
                end
            end
        end
    end
end

