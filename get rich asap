local function TryRequireConfig(ConfigName)
    local Module =
        ReplicatedStorage:FindFirstChild(
            ConfigName,
            true
        )

    if not Module
        or not Module:IsA("ModuleScript")
    then
        return nil
    end

    local Success, Result =
        pcall(function()
            return require(Module)
        end)

    if Success
        and type(Result) == "table"
    then
        return Result
    end

    return nil
end

local function FindEventFolder(EventName)
    local Folder =
        ReplicatedStorage:FindFirstChild(
            EventName,
            true
        )

    if not Folder then
        return nil
    end

    if Folder:IsA("Folder")
        or Folder:IsA("Model")
    then
        return Folder
    end

    return nil
end

local function FindRemote(
    EventFolder,
    RemoteName
)
    if not EventFolder then
        return nil
    end

    local Remote =
        EventFolder:FindFirstChild(
            RemoteName,
            true
        )

    if Remote
        and (
            Remote:IsA("RemoteFunction")
            or Remote:IsA("RemoteEvent")
        )
    then
        return Remote
    end

    return nil
end

local function GetUpgradeCost(
    Config,
    Upgrade
)
    local Cost =
        tonumber(
            Upgrade
                and Upgrade.Cost
        )
        or 0

    local BusinessCostUtil =
        TryRequireConfig(
            "BusinessCostUtil"
        )

    if BusinessCostUtil
        and type(
            BusinessCostUtil.GetDiscountedCost
        ) == "function"
    then
        local Success, Result =
            pcall(function()
                return BusinessCostUtil:
                    GetDiscountedCost(
                        LocalPlayer,
                        Cost
                    )
            end)

        if Success
            and tonumber(Result)
        then
            return tonumber(Result)
        end
    end

    return Cost
end

local function GetPurchasedUpgrades(Data)
    if type(Data) ~= "table" then
        return {}
    end

    if type(
        Data.PurchasedUpgrades
    ) == "table"
    then
        return Data.PurchasedUpgrades
    end

    if type(
        Data.PurchasedUpgradeIds
    ) == "table"
    then
        return Data.PurchasedUpgradeIds
    end

    return {}
end

local function HasUpgrade(
    PurchasedUpgrades,
    UpgradeId
)
    for _, Value in ipairs(
        PurchasedUpgrades
    ) do
        if Value == UpgradeId then
            return true
        end
    end

    return false
end

local function CreateUpgradeHandler(
    ConfigNames,
    EventNames
)
    return function()
        local Config

        for _, ConfigName in ipairs(
            ConfigNames
        ) do
            Config =
                TryRequireConfig(
                    ConfigName
                )

            if Config
                and type(
                    Config.Upgrades
                ) == "table"
            then
                break
            end

            Config = nil
        end

        if not Config
            or type(
                Config.Upgrades
            ) ~= "table"
        then
            return
        end

        local EventFolder

        for _, EventName in ipairs(
            EventNames
        ) do
            EventFolder =
                FindEventFolder(
                    EventName
                )

            if EventFolder then
                break
            end
        end

        if not EventFolder then
            return
        end

        local PerformAction =
            FindRemote(
                EventFolder,
                "PerformAction"
            )

        local RequestData =
            FindRemote(
                EventFolder,
                "RequestData"
            )

        if not PerformAction
            or not RequestData
        then
            return
        end

        if not PerformAction:IsA(
            "RemoteFunction"
        )
            or not RequestData:IsA(
                "RemoteFunction"
            )
        then
            return
        end

        local Success, Data =
            pcall(function()
                return RequestData:
                    InvokeServer()
            end)

        if not Success
            or type(Data) ~= "table"
        then
            return
        end

        local PurchasedUpgrades =
            GetPurchasedUpgrades(Data)

        local AvailableUpgrades = {}

        for _, Upgrade in ipairs(
            Config.Upgrades
        ) do
            if type(Upgrade) == "table"
                and Upgrade.Id ~= nil
                and not HasUpgrade(
                    PurchasedUpgrades,
                    Upgrade.Id
                )
            then
                table.insert(
                    AvailableUpgrades,
                    Upgrade
                )
            end
        end

        table.sort(
            AvailableUpgrades,
            function(A, B)
                return GetUpgradeCost(
                    Config,
                    A
                ) < GetUpgradeCost(
                    Config,
                    B
                )
            end
        )

        local NextUpgrade =
            AvailableUpgrades[1]

        if not NextUpgrade then
            return
        end

        pcall(function()
            PerformAction:
                InvokeServer(
                    "BuyUpgrade",
                    {
                        UpgradeId =
                            NextUpgrade.Id
                    }
                )
        end)
    end
end

