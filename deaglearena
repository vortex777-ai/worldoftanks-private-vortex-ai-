--====================================================
-- LOAD SCRIPT FUNCTION
--====================================================

local function LoadScript(scriptName, scriptUrl)
    if ScriptLoaded then
        WindUI:Notify({
            Title = "JulyScripts",
            Content = "Скрипт уже был запущен. Второй скрипт запустить нельзя.",
            Icon = "info",
            Duration = 4,
            CanClose = true,
        })

        return
    end

    if ScriptLoading then
        WindUI:Notify({
            Title = "JulyScripts",
            Content = "Другой скрипт уже загружается.",
            Icon = "loader",
            Duration = 3,
            CanClose = true,
        })

        return
    end

    ScriptLoading = true

    WindUI:Notify({
        Title = scriptName,
        Content = "Загрузка " .. scriptName .. "...",
        Icon = "loader",
        Duration = 3,
        CanClose = true,
    })

    local success, err = pcall(function()
        local source = game:HttpGet(scriptUrl)

        if not source or source == "" then
            error("Пустой ответ от GitHub")
        end

        local scriptFunction = loadstring(source)

        if not scriptFunction then
            error("Не удалось скомпилировать скрипт")
        end

        scriptFunction()
    end)

    if success then
        ScriptLoaded = true
        ScriptLoading = false

        WindUI:Notify({
            Title = scriptName,
            Content = scriptName .. " успешно загружен!",
            Icon = "check",
            Duration = 3,
            CanClose = true,
        })

        task.delay(3, function()
            pcall(function()
                Window:Destroy()
            end)
        end)

    else
        ScriptLoading = false

        WindUI:Notify({
            Title = scriptName,
            Content = "Ошибка загрузки:\n" .. tostring(err),
            Icon = "x",
            Duration = 6,
            CanClose = true,
        })
    end
end

