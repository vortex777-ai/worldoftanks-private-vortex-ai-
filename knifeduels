local function RestoreWeaponPart(Part, Data)
    if not Part or not Data then return end
    pcall(function()
        Part.Material = Data.Material
        Part.Color = Data.Color
        Part.Transparency = Data.Transparency
        Part.LocalTransparencyModifier = Data.LocalTransparencyModifier
    end)
end

local function ApplyWeaponChamsToPart(Part)
    if not WeaponChams.Enabled or not Part or not Part:IsA("BasePart") then return end

    if not WeaponChams.Stored[Part] then
        WeaponChams.Stored[Part] = {
            Material = Part.Material,
            Color = Part.Color,
            Transparency = Part.Transparency,
            LocalTransparencyModifier = Part.LocalTransparencyModifier
        }
    end

    pcall(function()
        Part.Material = WeaponChams.Material
        Part.Color = WeaponChams.Color
        Part.Transparency = WeaponChams.Transparency
        Part.LocalTransparencyModifier = 0
    end)
end

local function ApplyWeaponChams()
    if not WeaponChams.Enabled then return end

    local WeaponCamera = GetWeaponCamera()
    if not WeaponCamera then return end

    for _, WeaponModel in ipairs(WeaponCamera:GetChildren()) do
        local Knife = WeaponModel:FindFirstChild("Knife", true)
        if Knife then
            if Knife:IsA("BasePart") then
                ApplyWeaponChamsToPart(Knife)
            end

            for _, Object in ipairs(Knife:GetDescendants()) do
                if Object:IsA("BasePart") then
                    ApplyWeaponChamsToPart(Object)
                end
            end
        end
    end
end

local function StopWeaponChams()
    WeaponChams.Enabled = false

    if WeaponChams.Connection then
        WeaponChams.Connection:Disconnect()
        WeaponChams.Connection = nil
    end

    for Part, Data in pairs(WeaponChams.Stored) do
        RestoreWeaponPart(Part, Data)
    end

    table.clear(WeaponChams.Stored)
end

local function StartWeaponChams()
    if WeaponChams.Connection then return end

    WeaponChams.Enabled = true
    ApplyWeaponChams()

    local Elapsed = 0
    WeaponChams.Connection = RunService.Heartbeat:Connect(function(DeltaTime)
        if Unloaded or not WeaponChams.Enabled then return end

        Elapsed += DeltaTime
        if Elapsed < 0.1 then return end
        Elapsed = 0

        ApplyWeaponChams()
    end)
end

