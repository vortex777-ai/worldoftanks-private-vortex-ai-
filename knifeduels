local function StopThirdPerson()
    ThirdPerson.Enabled = false
    if ThirdPerson.Connection then
        ThirdPerson.Connection:Disconnect()
        ThirdPerson.Connection = nil
    end

    pcall(function()
        if ThirdPerson.OriginalCameraMode ~= nil then
            LocalPlayer.CameraMode = ThirdPerson.OriginalCameraMode
        end
        if ThirdPerson.OriginalMinZoomDistance ~= nil then
            LocalPlayer.CameraMinZoomDistance = ThirdPerson.OriginalMinZoomDistance
        end
        if ThirdPerson.OriginalMaxZoomDistance ~= nil then
            LocalPlayer.CameraMaxZoomDistance = ThirdPerson.OriginalMaxZoomDistance
        end

        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if Humanoid and ThirdPerson.OriginalCameraOffset ~= nil then
            Humanoid.CameraOffset = ThirdPerson.OriginalCameraOffset
        end
    end)
end

local function StartThirdPerson()
    if ThirdPerson.Connection then return end

    ThirdPerson.Enabled = true
    ThirdPerson.OriginalCameraMode = LocalPlayer.CameraMode
    ThirdPerson.OriginalMinZoomDistance = LocalPlayer.CameraMinZoomDistance
    ThirdPerson.OriginalMaxZoomDistance = LocalPlayer.CameraMaxZoomDistance

    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    ThirdPerson.OriginalCameraOffset = Humanoid and Humanoid.CameraOffset or Vector3.zero

    ThirdPerson.Connection = RunService.RenderStepped:Connect(function()
        if Unloaded or not ThirdPerson.Enabled then return end

        pcall(function()
            if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
            end

            if LocalPlayer.CameraMinZoomDistance ~= ThirdPerson.MinZoomDistance then
                LocalPlayer.CameraMinZoomDistance = ThirdPerson.MinZoomDistance
            end

            if LocalPlayer.CameraMaxZoomDistance ~= ThirdPerson.MaxZoomDistance then
                LocalPlayer.CameraMaxZoomDistance = ThirdPerson.MaxZoomDistance
            end

            local CurrentCamera = GetCamera()
            local Character = LocalPlayer.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

            if CurrentCamera and Humanoid then
                if CurrentCamera.CameraType ~= Enum.CameraType.Custom then
                    CurrentCamera.CameraType = Enum.CameraType.Custom
                end
                if CurrentCamera.CameraSubject ~= Humanoid then
                    CurrentCamera.CameraSubject = Humanoid
                end

                Humanoid.CameraOffset = ThirdPerson.CameraOffset
            end
        end)
    end)
end


local function GetHumanoid(Character)

    return Character and Character:FindFirstChildOfClass("Humanoid")

end

local function GetRootPart(Character)

    if not Character then return nil end

    return Character:FindFirstChild("HumanoidRootPart")

        or Character:FindFirstChild("UpperTorso")

        or Character:FindFirstChild("Torso")

        or Character:FindFirstChild("Head")

end

local function IsAlive(Character)

    local Humanoid = GetHumanoid(Character)

    return Character and Character.Parent and Humanoid and Humanoid.Health > 0

end

local function IsSameTeam(Player)

    if not Player or Player == LocalPlayer then return false end

    local LocalTeamId = LocalPlayer:GetAttribute("TeamID")

    local TeamId = Player:GetAttribute("TeamID")

    if LocalTeamId ~= nil and TeamId ~= nil then

        return LocalTeamId == TeamId

    end

    local LocalTeam = LocalPlayer:GetAttribute("Team")

    local Team = Player:GetAttribute("Team")

    if LocalTeam ~= nil and Team ~= nil then

        return LocalTeam == Team

    end

    local LocalMGTeam = LocalPlayer:GetAttribute("MG_Team")

    local MGTeam = Player:GetAttribute("MG_Team")

    if LocalMGTeam ~= nil and MGTeam ~= nil then

        return LocalMGTeam == MGTeam

    end

    if LocalPlayer.Team ~= nil and Player.Team ~= nil then

        return LocalPlayer.Team == Player.Team

    end

    return false

end

local function GetTargetPart(Character)

    if not Character then return nil end

    if Aimbot.AimAtHead then

        local Head = Character:FindFirstChild("Head")

        if Head and Head:IsA("BasePart") then

            return Head

        end

    end

    return Character:FindFirstChild("HumanoidRootPart")

        or Character:FindFirstChild("UpperTorso")

        or Character:FindFirstChild("Torso")

        or Character:FindFirstChild("Head")

end

local function IsVisible(TargetPart)

    if not Aimbot.WallCheck then return true end

    local CurrentCamera = GetCamera()

    local TargetCharacter = TargetPart and TargetPart.Parent

    if not CurrentCamera or not TargetCharacter then return false end

    local Origin = CurrentCamera.CFrame.Position

    local Direction = TargetPart.Position - Origin

    if Direction.Magnitude <= 0.001 then return true end

    local Params = RaycastParams.new()

    Params.FilterType = Enum.RaycastFilterType.Blacklist

    Params.FilterDescendantsInstances = {LocalPlayer.Character, TargetCharacter}

    Params.IgnoreWater = true

    Params.RespectCanCollide = true

    return Workspace:Raycast(Origin, Direction, Params) == nil

end

local function CreateFOVCircle()

    if Aimbot.FOVCircle then return end

    Aimbot.FOVCircle = Drawing.new("Circle")

    Aimbot.FOVCircle.Filled = false

    Aimbot.FOVCircle.NumSides = 64

    Aimbot.FOVCircle.Thickness = Aimbot.FOVCircleThickness

    Aimbot.FOVCircle.Transparency = 1

    Aimbot.FOVCircle.Color = Aimbot.FOVCircleColor

    Aimbot.FOVCircle.Visible = false

end

local function UpdateFOVCircle()

    CreateFOVCircle()

    if Unloaded or not Aimbot.Enabled or not Aimbot.ShowFOVCircle then

        Aimbot.FOVCircle.Visible = false

        return

    end

    local CurrentCamera = GetCamera()

    if not CurrentCamera then

        Aimbot.FOVCircle.Visible = false

        return

    end

    local Viewport = CurrentCamera.ViewportSize

    Aimbot.FOVCircle.Position = Vector2.new(Viewport.X / 2, Viewport.Y / 2)

    Aimbot.FOVCircle.Radius = Aimbot.FOVRadius

    Aimbot.FOVCircle.Thickness = Aimbot.FOVCircleThickness

    Aimbot.FOVCircle.Color = Aimbot.FOVCircleColor

    Aimbot.FOVCircle.Visible = true

end

local function GetClosestTarget()

    local CurrentCamera = GetCamera()

    if not CurrentCamera then return nil end

    local Viewport = CurrentCamera.ViewportSize

    local Center = Vector2.new(Viewport.X / 2, Viewport.Y / 2)

    local BestTarget = nil

    local BestFOV = math.huge

    for _, Player in ipairs(Players:GetPlayers()) do

        if Player ~= LocalPlayer then

            if not (Aimbot.TeamCheck and IsSameTeam(Player)) then

                local Character = Player.Character

                if Character and Character:IsDescendantOf(Workspace) and IsAlive(Character) then

                    local TargetPart = GetTargetPart(Character)

                    if TargetPart then

                        local WorldDistance = (TargetPart.Position - CurrentCamera.CFrame.Position).Magnitude

                        if WorldDistance <= Aimbot.Range and IsVisible(TargetPart) then

                            local Screen, OnScreen = CurrentCamera:WorldToViewportPoint(TargetPart.Position)

                            if OnScreen and Screen.Z > 0 then

                                local Point = Vector2.new(Screen.X, Screen.Y)

                                local FOV = (Point - Center).Magnitude

                                if FOV <= Aimbot.FOVRadius and FOV < BestFOV then

                                    BestFOV = FOV

                                    BestTarget = TargetPart

                                end

                            end

                        end

                    end

                end

            end

        end

    end

    return BestTarget

end

local function AimAt(TargetPart, DeltaTime)

    if not TargetPart or not TargetPart.Parent then return end

    local CurrentCamera = GetCamera()

    if not CurrentCamera or not IsAlive(TargetPart.Parent) then return end

    local TargetCFrame = CFrame.lookAt(CurrentCamera.CFrame.Position, TargetPart.Position)

    local Alpha

    if Aimbot.Smoothness <= 0 then

        Alpha = 1

    else

        Alpha = 1 - math.exp(-Aimbot.Smoothness * DeltaTime * 12)

        Alpha = math.clamp(Alpha, 0, 1)

    end

    CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(TargetCFrame, Alpha)

end

local function UpdateAimbot(DeltaTime)

    if Unloaded or not Aimbot.Enabled or not Aimbot.Keybind or not Aimbot.Keybind.Toggled then

        Aimbot.Target = nil

        return

    end

    Aimbot.Target = GetClosestTarget()

    if Aimbot.Target then

        AimAt(Aimbot.Target, DeltaTime)

    end

end

local function CreateDrawing(Type, Properties)

    local Object = Drawing.new(Type)

    for Property, Value in pairs(Properties) do

        Object[Property] = Value

    end

    return Object

end

local function HideDrawings(Data)

    for _, Object in pairs(Data or {}) do

        Object.Visible = false

    end

end

local function RemoveDrawings(Data)

    for _, Object in pairs(Data or {}) do

        pcall(function()

            Object.Visible = false

            Object:Remove()

        end)

    end

end

local function GetESPData(Player)

    if Drawings[Player] then return Drawings[Player] end

    Drawings[Player] = {

        BoxOutline = CreateDrawing("Square", {Thickness = 3, Color = Color3.fromRGB(0,0,0), Filled = false, Visible = false}),

        Box = CreateDrawing("Square", {Thickness = 1, Color = ESP.BoxColor, Filled = false, Visible = false}),

        Name = CreateDrawing("Text", {Size = ESP.NameSize, Center = true, Outline = true, Color = ESP.NameColor, Visible = false}),

        Distance = CreateDrawing("Text", {Size = ESP.DistanceSize, Center = true, Outline = true, Color = ESP.DistanceColor, Visible = false}),

        HealthBarOutline = CreateDrawing("Line", {Thickness = 3, Color = Color3.fromRGB(0,0,0), Visible = false}),

        HealthBar = CreateDrawing("Line", {Thickness = 1, Visible = false}),

        Tracer = CreateDrawing("Line", {Thickness = ESP.TracerThickness, Color = ESP.TracerColor, Visible = false}),

        HeadDot = CreateDrawing("Circle", {Radius = ESP.HeadDotRadius, Filled = true, Color = ESP.HeadDotColor, Visible = false})

    }

    return Drawings[Player]

end

local function UpdateESPPlayer(Player, Data)

    if Unloaded or not ESP.Enabled or Player == LocalPlayer then

        HideDrawings(Data)

        return

    end

    local Character = Player.Character

    if not Character or not Character:IsDescendantOf(Workspace) or not IsAlive(Character) then

        HideDrawings(Data)

        return

    end

    local Humanoid = GetHumanoid(Character)

    local RootPart = GetRootPart(Character)

    local CurrentCamera = GetCamera()

    if not Humanoid or not RootPart or not CurrentCamera then

        HideDrawings(Data)

        return

    end

    local Distance = (CurrentCamera.CFrame.Position - RootPart.Position).Magnitude

    if Distance > ESP.MaxDistance then

        HideDrawings(Data)

        return

    end

    local R15 = Humanoid.RigType == Enum.HumanoidRigType.R15

    local Top, TopOnScreen = CurrentCamera:WorldToViewportPoint(RootPart.Position + Vector3.new(0, R15 and 3.2 or 2.5, 0))

    local Bottom, BottomOnScreen = CurrentCamera:WorldToViewportPoint(RootPart.Position - Vector3.new(0, R15 and 3.4 or 2.8, 0))

    if not TopOnScreen and not BottomOnScreen or Top.Z <= 0 then

        HideDrawings(Data)

        return

    end

    local Height = math.abs(Top.Y - Bottom.Y)

    if Height <= 1 then

        HideDrawings(Data)

        return

    end

    local Width = Height * 0.6

    local X = Top.X - Width * 0.5

    local Y = Top.Y

    Data.BoxOutline.Thickness = ESP.BoxThickness + 2

    Data.Box.Thickness = ESP.BoxThickness

    Data.Name.Size = ESP.NameSize

    Data.Distance.Size = ESP.DistanceSize

    Data.Tracer.Thickness = ESP.TracerThickness

    Data.HeadDot.Radius = ESP.HeadDotRadius

    local BoxColor = ESP.BoxColor

    if ESP.TeamColor then

        BoxColor = IsSameTeam(Player) and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)

    end

    if ESP.Boxes then

        Data.BoxOutline.Size = Vector2.new(Width, Height)

        Data.BoxOutline.Position = Vector2.new(X, Y)

        Data.BoxOutline.Visible = true

        Data.Box.Size = Vector2.new(Width, Height)

        Data.Box.Position = Vector2.new(X, Y)

        Data.Box.Color = BoxColor

        Data.Box.Visible = true

    else

        Data.BoxOutline.Visible = false

        Data.Box.Visible = false

    end

    if ESP.Names then

        Data.Name.Position = Vector2.new(Top.X, Y - ESP.NameSize - 2)

        Data.Name.Text = Player.DisplayName

        Data.Name.Color = ESP.NameColor

        Data.Name.Visible = true

    else

        Data.Name.Visible = false

    end

    if ESP.Distance then

        Data.Distance.Position = Vector2.new(Top.X, Bottom.Y + 2)

        Data.Distance.Text = string.format("[%d studs]", math.floor(Distance))

        Data.Distance.Color = ESP.DistanceColor

        Data.Distance.Visible = true

    else

        Data.Distance.Visible = false

    end

    if ESP.HealthBar then

        local Health = Humanoid.MaxHealth > 0 and math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1) or 1

        local BarX = X - 5

        Data.HealthBarOutline.From = Vector2.new(BarX, Y)

        Data.HealthBarOutline.To = Vector2.new(BarX, Y + Height)

        Data.HealthBarOutline.Visible = true

        Data.HealthBar.From = Vector2.new(BarX, Y + Height)

        Data.HealthBar.To = Vector2.new(BarX, Y + Height - Height * Health)

        Data.HealthBar.Color = Color3.fromRGB(255 - math.floor(Health * 255), math.floor(Health * 255), 0)

        Data.HealthBar.Visible = true

    else

        Data.HealthBarOutline.Visible = false

        Data.HealthBar.Visible = false

    end

    if ESP.Tracers then

        local ShowTracer = true

        local TracerColor = ESP.TracerColor

        if ESP.TracerOnlyEnemy then

            if IsSameTeam(Player) then

                ShowTracer = false

            else

                TracerColor = Color3.fromRGB(255,255,255)

            end

        else

            TracerColor = IsSameTeam(Player) and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)

        end

        if ShowTracer then

            local Viewport = CurrentCamera.ViewportSize

            Data.Tracer.From = Vector2.new(Viewport.X * 0.5, Viewport.Y)

            Data.Tracer.To = Vector2.new(Top.X, Bottom.Y)

            Data.Tracer.Color = TracerColor

            Data.Tracer.Visible = true

        else

            Data.Tracer.Visible = false

        end

    else

        Data.Tracer.Visible = false

    end

    if ESP.HeadDots then

        local Head = Character:FindFirstChild("Head")

        if Head and Head:IsA("BasePart") then

            local HeadPosition, OnScreen = CurrentCamera:WorldToViewportPoint(Head.Position)

            if OnScreen and HeadPosition.Z > 0 then

                Data.HeadDot.Position = Vector2.new(HeadPosition.X, HeadPosition.Y)

                Data.HeadDot.Color = ESP.HeadDotColor

                Data.HeadDot.Visible = true

            else

                Data.HeadDot.Visible = false

            end

        else

            Data.HeadDot.Visible = false

        end

    else

        Data.HeadDot.Visible = false

    end

end

local function StartESP()

    if Connections.ESP then

        pcall(function() Connections.ESP:Disconnect() end)

    end

    Connections.ESP = RunService.RenderStepped:Connect(function()

        if Unloaded then return end

        for _, Player in ipairs(Players:GetPlayers()) do

            if Player ~= LocalPlayer then

                UpdateESPPlayer(Player, GetESPData(Player))

            end

        end

    end)

end

local function StopESP()

    for _, Data in pairs(Drawings) do

        HideDrawings(Data)

    end

end

local function EnableESP()

    ESP.Enabled = true

    for _, Player in ipairs(Players:GetPlayers()) do

        if Player ~= LocalPlayer then

            GetESPData(Player)

        end

    end

    StartESP()

end

local function DisableESP()

    ESP.Enabled = false

    StopESP()

end


local PlayerMovement = {
    FlyEnabled = false, FlySpeed = 50, FlyKeybind = nil, FlyConnection = nil, SavedStates = {},
    SpeedEnabled = false, SpeedValue = 100, SpeedKeybind = nil, SpeedConnection = nil
}

local function GetLocalCharacter()
    local Character = LocalPlayer.Character
    if not Character or not Character.Parent then return nil, nil, nil end
    return Character, Character:FindFirstChildOfClass("Humanoid"), Character:FindFirstChild("HumanoidRootPart")
end

local function StartFly()
    if PlayerMovement.FlyConnection then return end
    local Character, Humanoid, RootPart = GetLocalCharacter()
    if not Character or not Humanoid or not RootPart then return end
    PlayerMovement.FlyEnabled = true
    PlayerMovement.SavedStates = {}
    for _, State in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
        PlayerMovement.SavedStates[State] = Humanoid:GetStateEnabled(State)
        Humanoid:SetStateEnabled(State, false)
    end
    PlayerMovement.FlyConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if Unloaded or not PlayerMovement.FlyEnabled or not PlayerMovement.FlyKeybind or not PlayerMovement.FlyKeybind.Toggled then return end
        local _, CurrentHumanoid, CurrentRoot = GetLocalCharacter()
        local CurrentCamera = GetCamera()
        if not CurrentHumanoid or not CurrentRoot or not CurrentCamera then return end
        local UserInputService = game:GetService("UserInputService")
        local MoveVector = Vector3.zero
        local Forward = CurrentCamera.CFrame.LookVector
        local Right = CurrentCamera.CFrame.RightVector
        local Up = CurrentCamera.CFrame.UpVector
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then MoveVector += Forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then MoveVector -= Forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then MoveVector -= Right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then MoveVector += Right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then MoveVector += Up end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then MoveVector -= Up end
        if MoveVector.Magnitude > 0.001 then
            CurrentRoot.CFrame = CurrentRoot.CFrame + MoveVector.Unit * PlayerMovement.FlySpeed * DeltaTime
        end
        CurrentRoot.AssemblyLinearVelocity = Vector3.zero
        CurrentRoot.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function StopFly()
    PlayerMovement.FlyEnabled = false
    if PlayerMovement.FlyConnection then PlayerMovement.FlyConnection:Disconnect(); PlayerMovement.FlyConnection = nil end
    local _, Humanoid, RootPart = GetLocalCharacter()
    if Humanoid then
        for State, Enabled in pairs(PlayerMovement.SavedStates) do pcall(function() Humanoid:SetStateEnabled(State, Enabled) end) end
    end
    PlayerMovement.SavedStates = {}
    if RootPart then RootPart.AssemblyLinearVelocity = Vector3.zero; RootPart.AssemblyAngularVelocity = Vector3.zero end
end

local function StartSpeed()
    if PlayerMovement.SpeedConnection then return end
    PlayerMovement.SpeedEnabled = true
    PlayerMovement.SpeedConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if Unloaded or not PlayerMovement.SpeedEnabled or not PlayerMovement.SpeedKeybind or not PlayerMovement.SpeedKeybind.Toggled then return end
        local _, Humanoid, RootPart = GetLocalCharacter()
        if not Humanoid or not RootPart or Humanoid.Health <= 0 then return end
        local MoveDirection = Humanoid.MoveDirection
        local HorizontalDirection = Vector3.new(MoveDirection.X, 0, MoveDirection.Z)
        if HorizontalDirection.Magnitude <= 0.001 then return end
        RootPart.CFrame = RootPart.CFrame + HorizontalDirection.Unit * PlayerMovement.SpeedValue * DeltaTime
    end)
end

local function StopSpeed()
    PlayerMovement.SpeedEnabled = false
    if PlayerMovement.SpeedConnection then PlayerMovement.SpeedConnection:Disconnect(); PlayerMovement.SpeedConnection = nil end
end

local function UnloadScript()
    if Unloaded then return end
    Unloaded = true
    StopFly(); StopSpeed(); StopThirdPerson(); StopWeaponChams(); StopLocalPlayerChams()
    Aimbot.Enabled = false; Aimbot.IsAiming = false; Aimbot.Target = nil; ESP.Enabled = false
    for Name, Connection in pairs(Connections) do pcall(function() Connection:Disconnect() end); Connections[Name] = nil end
    if Aimbot.FOVCircle then pcall(function() Aimbot.FOVCircle.Visible = false; Aimbot.FOVCircle:Remove() end); Aimbot.FOVCircle = nil end
    for Player, Data in pairs(Drawings) do RemoveDrawings(Data); Drawings[Player] = nil end
    table.clear(Drawings)
    pcall(function() Library:Unload() end)
end

